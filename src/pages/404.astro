---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/strings';
const en = t('en'); const tr = t('tr');
---
<Base lang="en" title={en.meta.notFoundTitle} description={en.notFound.p} path="/404/" noindex>
  <div class="wrap page">
    <h1>{en.notFound.title}</h1>
    <p class="lead">{en.notFound.p} <a href="/">{en.notFound.back}</a>.</p>
    <p class="lead" lang="tr">{tr.notFound.p} <a href="/tr/">{tr.notFound.back}</a>.</p>
  </div>
</Base>
