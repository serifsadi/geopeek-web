---
// Required basemap attribution, printed next to every map image.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<p class:list={['map-credit', cls]}>
  <a href="https://openfreemap.org">© OpenFreeMap</a> <a href="https://openmaptiles.org">© OpenMapTiles</a> <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a>
</p>
<style>
  .map-credit{font-size:12px;line-height:1.4;color:var(--muted);margin:0}
  .map-credit a{color:inherit;text-decoration:none}
  .map-credit a:hover{text-decoration:underline}
</style>
